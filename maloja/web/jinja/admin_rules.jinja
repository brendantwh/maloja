{% set page ='admin_rules' %}
{% extends "abstracts/library.jinja" %}
{% block title %}Maloja - Rules{% endblock %}

{% set data = dbc.get_parser_rules() %}
{% set setnames = {} %}
{% for rs in data.rulesets %}{% set _ = setnames.update({rs.file: rs.name}) %}{% endfor %}
{# links from artist and track pages open the form prefilled, see icons/rule_link.jinja #}
{% set prefill = {
	'type': request.query.get('type',''),
	'fields': [request.query.getunicode('f0') or '', request.query.getunicode('f1') or '', request.query.getunicode('f2') or ''],
	'scope': request.query.getunicode('scope') or '',
	'note': request.query.getunicode('note') or ''
} %}

{% block libscripts %}
	<script type="application/json" id="rules-data">{{ {'rules': data.rules, 'types': data.types, 'setnames': setnames, 'prefill': prefill} | tojson }}</script>
	<script>
	document.addEventListener('DOMContentLoaded', function() {
		const { $, esc, plural, pills, diff, trackDiff, toast, api } = Lib;
		const DATA = Lib.data('rules-data');
		const SERVER_TYPES = DATA.types;
		const { types: TYPES, SEP, isList, scopable, info, values, stored, sourceLabel, describe } = Lib.ruleKit(SERVER_TYPES, DATA.setnames);
		const GROUPS = ['Artists', 'Titles', 'Albums', 'Charts'];

		// the list

		let rules = DATA.rules, group = 'All';

		async function refresh() {
			rules = (await api('rules', {}, 'GET')).rules;
			render();
		}

		function render() {
			$('rule-groups').innerHTML = ['All', ...GROUPS].map(g => {
				const n = g === 'All' ? rules.length : rules.filter(r => info(r.type).group === g).length;
				return `<button type="button" class="chip ${g === group ? 'on' : ''}" data-click="group" data-group="${g}">${g} <span class="count">${n}</span></button>`;
			}).join('');
			const q = $('rule-search').value.toLowerCase();
			const shown = rules.filter(r => (group === 'All' || info(r.type).group === group)
				&& [info(r.type).label, ...r.fields, r.scope || '', r.note || '', sourceLabel(r.source)].join(' ').replaceAll(SEP, ' ').toLowerCase().includes(q));
			$('rules-body').innerHTML = shown.map(r => `
				<tr class="${r.enabled ? '' : 'off'}">
					<td><label class="switch" title="${r.enabled ? 'Switch off' : 'Switch on'}"><input type="checkbox" ${r.enabled ? 'checked' : ''} data-change="toggle" data-id="${r.id}"><span></span></label></td>
					<td class="dim">${esc(info(r.type).short)}</td>
					<td class="dim">${describe(r.type, values(r))}${r.note ? `<div class="note">${esc(r.note)}</div>` : ''}</td>
					<td class="dim">${r.scope ? `<span class="tag scope">${esc(r.scope)}</span>` : '<span class="count">all artists</span>'}</td>
					<td class="dim"><span class="tag">${esc(sourceLabel(r.source))}</span></td>
					<td class="row-actions"><button type="button" class="icon-btn" title="Edit" data-click="edit" data-id="${r.id}">✎</button><button type="button" class="icon-btn" title="Delete" data-click="delete" data-id="${r.id}">🗑</button></td>
				</tr>`).join('');
			$('rules-empty').textContent = rules.length ? 'No rules match.' : 'No rules of your own yet. Add one, or switch on a rule set.';
			$('rules-empty').style.display = shown.length ? 'none' : '';
		}

		const ruleById = id => rules.find(r => r.id === +id);

		// new and edit

		let editing = null;   // { id, type }

		function openPicker() {
			editing = { id: null, type: null };
			const intent = t => `<button type="button" class="intent" data-click="choose" data-type="${t}">${esc(TYPES[t].label)}<span class="ex">${esc(TYPES[t].ex)}</span></button>`;
			const common = Object.keys(TYPES).filter(t => TYPES[t].common), more = Object.keys(TYPES).filter(t => !TYPES[t].common);
			Lib.openDrawer('New rule', `
				<div class="field"><label>What do you want to do?</label></div>
				<div class="intents">${common.map(intent).join('')}</div>
				<details class="more-intents"><summary>More kinds of rules</summary>
					<div class="intents" style="margin-top:10px">${more.map(intent).join('')}</div>
				</details>`);
		}

		function openForm(type, v, scope, note) {
			const T = info(type);
			const back = editing.id ? '' : `<button type="button" class="btn ghost" data-click="picker">← Change</button>`;
			let html = `<div class="chosen"><span>${esc(T.label)}</span>${back}</div>`;
			for (const [label, kind, i] of T.fields) {
				const value = v ? v[i] : '';
				html += `<div class="field"><label>${esc(label)}</label>${kind === 'chips'
					? `<div class="chipinput" data-field="${i}"></div><div class="hint">Type a name and press Enter. Several names mean several artists.</div>`
					: `<input type="text" data-field="${i}" value="${esc(value)}">`}</div>`;
			}
			if (scopable(type)) {
				html += `<div class="field"><label>Only for artist <span class="count">(optional)</span></label><input type="text" id="rule-scope" placeholder="All artists" value="${esc(scope || '')}"><div class="hint">The rule only applies when this artist is on the scrobble.</div></div>`;
			}
			html += `<div class="field"><label>Note <span class="count">(optional)</span></label><input type="text" id="rule-note" value="${esc(note || '')}"></div>`;
			if (T.hint) html += `<div class="hint" style="margin-bottom:16px">${esc(T.hint)}</div>`;
			html += `<div class="preview"><div class="label">Preview</div><div id="rule-preview"></div></div>`;
			const foot = `<button type="button" class="btn secondary" data-click="lib-close">Cancel</button><button type="button" class="btn" data-click="save">${editing.id ? 'Save changes' : 'Add rule'}</button>`;
			Lib.openDrawer(editing.id ? 'Edit rule' : 'New rule', html, foot, preview);
			for (const box of document.querySelectorAll('#lib-drawer .chipinput')) {
				Lib.chipInput(box, v ? v[+box.dataset.field] : [], preview);
			}
			preview();
			const first = $('lib-drawer-body').querySelector('input');
			if (first) first.focus();
		}

		function formValues() {
			return SERVER_TYPES[editing.type].fields.map((_, i) => {
				const el = $('lib-drawer-body').querySelector(`[data-field="${i}"]`);
				return el.classList.contains('chipinput') ? Lib.chipValues(el) : el.value.trim();
			});
		}
		const filled = v => v.every(x => Array.isArray(x) ? x.length : x);

		function preview() {
			const box = $('rule-preview');
			if (!box) return;
			const v = formValues(), scope = $('rule-scope') ? $('rule-scope').value.trim() : '';
			if (!filled(v)) { box.innerHTML = '<span class="count">Fill in the fields to see an example.</span>'; return; }
			const who = scope || 'Any artist', track = (artists, title) => ({ artists, title });
			const show = (a, b) => {
				const [l, r] = trackDiff(a, b);
				box.innerHTML = `<div class="row">${l}</div><div class="row"><span class="arrow" style="margin-left:0">→</span>${r}</div>`;
			};
			const say = html => { box.innerHTML = `<div class="row">${html}</div>`; };
			switch (editing.type) {
				case 'replaceartist': return show(track([v[0]], 'Song'), track(v[1], 'Song'));
				case 'replacetitle': return show(track([who], v[0]), track([who], v[1]));
				case 'replacealbumtitle': { const [l, r] = diff(v[0], v[1]); return say(`Album: ${l}</div><div class="row"><span class="arrow" style="margin-left:0">→</span>Album: ${r}`); }
				case 'fixartists': return show(track([v[0][0]], v[1]), track(v[0], v[1]));
				case 'addartists': return show(track(v[0], v[1]), track([...v[0], ...v[2]], v[1]));
				case 'artistintitle': return show(track([who], `Song (${v[0]})`), track([who, ...v[1]], `Song (${v[0]})`));
				case 'belongtogether': return say(`${esc(v[0])} stays <b>one</b> artist, instead of being split.`);
				case 'countas': return say(`In charts, scrobbles of ${esc(v[0])} also count for ${esc(v[1])}.`);
				case 'ignoreartist': return say(`${esc(v[0])} is dropped from scrobbles.`);
				case 'notanartist': return say(`"feat. ${esc(v[0])}" stays in the title and doesn't become an artist.`);
				default: return say(describe(editing.type, v));
			}
		}

		async function save() {
			const v = formValues();
			if (!filled(v)) { Lib.warn('Fill in all fields first.'); return; }
			const payload = {
				type: editing.type,
				fields: stored(editing.type, v),
				scope: $('rule-scope') ? $('rule-scope').value.trim() : '',
				note: $('rule-note').value.trim(),
			};
			if (editing.id) {
				await api('edit_rule', { ...payload, id: editing.id });
				toast('Rule saved. It applies to new scrobbles now.');
			} else {
				await api('add_rule', payload);
				toast('Rule added. It applies to new scrobbles now.');
			}
			Lib.closeDrawer();
			group = 'All';
			await refresh();
		}

		// try a scrobble

		let tryTimer = null, tryCount = 0;
		function openTry() {
			Lib.openDrawer('Try a scrobble', `
				<div class="lead">See how a scrobble would be stored with the current rules. Nothing is saved.</div>
				<div class="field"><label>Artists, as your player sends them</label><input type="text" id="try-artists" placeholder="Simon & Garfunkel"></div>
				<div class="field"><label>Title</label><input type="text" id="try-title" placeholder="The Boxer"></div>
				<div class="field"><label>Album <span class="count">(optional)</span></label><input type="text" id="try-album"></div>
				<div class="preview" id="try-result"><span class="count">Type an artist and a title.</span></div>`,
				`<button type="button" class="btn secondary" data-click="lib-close">Close</button>`,
				() => { clearTimeout(tryTimer); tryTimer = setTimeout(runTry, 300); });
			$('try-artists').focus();
		}
		async function runTry() {
			const out = $('try-result');
			if (!out) return;
			const artists = $('try-artists').value.trim(), title = $('try-title').value.trim(), album = $('try-album').value.trim();
			if (!artists || !title) { out.innerHTML = '<span class="count">Type an artist and a title.</span>'; return; }
			const mine = ++tryCount;
			let r;
			try { r = await api('test_rules', { artists, title, album }, 'POST', { quiet: true }); }
			catch (e) { if (mine === tryCount) out.innerHTML = `<span class="count">${esc(e.message)}</span>`; return; }
			if (mine !== tryCount || !$('try-result')) return;
			const [l, rr] = trackDiff({ artists: [artists], title }, { artists: r.artists, title: r.title });
			const fired = rule => `<div class="rule"><span class="tag">${esc(info(rule.type).short)}</span> ${describe(rule.type, values(rule))} ${rule.scope ? `<span class="tag scope">${esc(rule.scope)}</span>` : ''} <span class="count">· ${esc(rule.source && rule.source !== 'user' ? sourceLabel(rule.source) : 'your rule')}</span></div>`;
			out.innerHTML = `
				<div class="label">Sent</div><div class="row">${l}${album ? ` <span class="count">· ${esc(album)}</span>` : ''}</div>
				<div class="label" style="margin-top:10px">Stored as</div><div class="row">${rr}${r.album ? ` <span class="count">· ${esc(r.album)}</span>` : ''}</div>
				<div class="row count" style="margin-top:4px">${plural(r.artists.length, 'artist')}: ${pills(r.artists)}</div>
				<div class="label" style="margin-top:12px">Rules that fired</div>
				<div class="fired">${r.rules.length ? r.rules.map(fired).join('') : '<span class="count">None, the built-in parsing did it all.</span>'}</div>
				${r.countas.length ? `<div class="label" style="margin-top:12px">In charts</div><div class="fired">${r.countas.map(fired).join('')}</div>` : ''}`;
		}

		// import

		function openImport() {
			Lib.openDrawer('Import rules', `
				<div class="field"><label>Rule file</label><input type="file" id="import-file" accept=".tsv,.txt,text/tab-separated-values"></div>
				<div class="field"><label>Or paste rules</label><textarea rows="8" class="mono" id="import-text" style="width:100%" placeholder="replacetitle&#9;RED&#9;Red&#9;artist=HyunA"></textarea>
				<div class="hint">One rule per line, columns separated by tabs (the format in rules.info). Rules you already have are skipped.</div>
				<div class="errors" id="import-errors"></div></div>`,
				`<button type="button" class="btn secondary" data-click="lib-close">Cancel</button><button type="button" class="btn" data-click="do-import">Import</button>`);
			$('import-file').onchange = function() {
				const reader = new FileReader();
				reader.onload = () => { $('import-text').value = reader.result; };
				reader.readAsText(this.files[0]);
			};
		}
		async function doImport() {
			const text = $('import-text').value;
			if (!text.trim()) { Lib.warn('Pick a file or paste some rules first.'); return; }
			const r = await api('import_rules_tsv', { text });
			await refresh();
			if (r.errors.length) {
				$('import-errors').textContent = `${plural(r.added, 'rule')} added, ${r.existing} already there. These lines were not imported:\n\n` + r.errors.join('\n');
			} else {
				Lib.closeDrawer();
				toast(`${plural(r.added, 'rule')} added, ${r.existing} already there.`);
			}
		}

		Lib.actions({
			group(el) { group = el.dataset.group; render(); },
			search() { render(); },
			async toggle(el) {
				const r = ruleById(el.dataset.id), on = el.checked;
				try { await api('toggle_rule', { id: r.id, enabled: on }); }
				catch (e) { el.checked = !on; return; }
				r.enabled = on;
				render();
				toast(on ? 'Rule switched on.' : 'Rule switched off.');
			},
			edit(el) {
				const r = ruleById(el.dataset.id);
				editing = { id: r.id, type: r.type };
				openForm(r.type, values(r), r.scope, r.note);
			},
			async delete(el) {
				const r = ruleById(el.dataset.id);
				await api('delete_rule', { id: r.id });
				await refresh();
				// it's gone on the server, so undo adds it again
				toast('Rule deleted.', { undo: async () => {
					const { id } = await api('add_rule', { type: r.type, fields: r.fields, scope: r.scope || '', note: r.note });
					if (!r.enabled) await api('toggle_rule', { id, enabled: false });
					await refresh();
				} });
			},
			'new': openPicker,
			picker: openPicker,
			choose(el) { editing.type = el.dataset.type; openForm(editing.type); },
			save,
			'try': openTry,
			'import': openImport,
			'do-import': doImport,
			async reload() {
				await api('reload_rules');
				await refresh();
				toast('Rule files reloaded.');
			},
		});

		render();

		const P = DATA.prefill;
		if (P.type && SERVER_TYPES[P.type]) {
			editing = { id: null, type: P.type };
			const v = SERVER_TYPES[P.type].fields.map((_, i) => isList(P.type, i) ? P.fields[i].split(SEP).filter(Boolean) : P.fields[i]);
			openForm(P.type, v, P.scope, P.note);
		}
	});
	</script>
{% endblock %}

{% block librarycontent %}
	<div class="page-head">
		<div class="title">
			<h2>Rules <span class="help" tabindex="0">?<span class="tip">Rules change how incoming scrobbles are read: fix spellings, keep band names whole, add missing artists.<br><br>They apply to new scrobbles right away. To apply them to scrobbles you already have, use <a class="textlink" href="/admin_reparse">Reparse</a>.<br><br>Names are compared ignoring case, except where a rule says otherwise. <code>.tsv</code> files dropped into the rules folder are imported on the next start or reload.</span></span></h2>
			<div class="lead">Your own fixes for how scrobbles are read.</div>
		</div>
		<div class="actions">
			<button type="button" class="btn secondary" data-click="try">Try a scrobble</button>
			<button type="button" class="btn" data-click="new">+ New rule</button>
			<button type="button" class="icon-btn" style="font-size:20px" data-menu="rules-menu" title="More">⋯</button>
			<div class="menu" id="rules-menu">
				<button type="button" data-click="import">Import rules…</button>
				<a href="/apis/mlj_1/export_rules" class="no-intercept">Export my rules</a>
				<div class="sep"></div>
				<button type="button" data-click="reload">Reload rule files</button>
			</div>
		</div>
	</div>
	<div class="toolbar">
		<input type="search" id="rule-search" placeholder="Search rules" data-input="search">
		<div class="chips" id="rule-groups"></div>
	</div>
	<table class="lib">
		<thead><tr><th style="width:56px">On</th><th style="width:150px">What</th><th>Rule</th><th style="width:150px">Only for</th><th style="width:140px">From</th><th></th></tr></thead>
		<tbody id="rules-body"></tbody>
	</table>
	<div class="empty" id="rules-empty" style="display:none"></div>
{% endblock %}
